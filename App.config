<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<!-- Local Windows Application Settings for this build ENV. -->
		<add key="build_env" value="test" />
		<add key="code_version" value="v0.5" />
		<add key="access_name" value="access_name" />
		<add key="access_credential" value="access_pwd" />
		<add key="server_location" value="localhost" />  <!-- Could be alias name or IP Address -->
		<add key="database_name" value="db_test" />
	</appSettings>
</configuration>